# Copy to .env and fill in. VITE_* values end up in the browser bundle: never
# put a secret here.

# Backend API base, including /api/v1/ and the trailing slash.
VITE_API_BASE_URL=https://api.themarcopassport.com/api/v1/

# Host that image paths from the API (e.g. /images/abc.jpg) are relative to.
# No trailing slash.
VITE_IMAGE_BASE_URL=https://api.themarcopassport.com
